# ─────────────────────────────────────────────────────────────
# v4-chat — ignore rules
# ─────────────────────────────────────────────────────────────

# macOS
.DS_Store

# Build outputs / generated artifacts
/build/
/dist/
*.o
*.class
__pycache__/
*.log

# Native loader + Java agent build outputs
/src/injector/loader_test
/src/injector/shatest
/src/injector/java_agent/agent.jar

# The packed bundle is generated by `make bundle` from the payloads below
/bundle.dat

# Vendored decompiler binaries — fetch with scripts/fetch-tools.sh
/tools/*.jar

# Derived deobfuscation output (regenerate with zkm-flowdeobf)
/payload_jar/vape_client_deobf.jar
/payload_jar/vape_client_deobf_full.jar
/payload_jar/deobf_report*.tsv
/payload_jar/vape_client_renamed.jar
/payload_jar/vape_inner.bin
/payload_jar/classes/
/payload_jar/deobf_classes/

# Staging dir used by scripts/update-payload.sh while decompiling
/src/decompiled.tmp/
/src/decompiled.tmp.old/

# Vendored deobfuscator build output
/zkm-flowdeobf/build/
/zkm-flowdeobf/.gradle/
