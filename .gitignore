# ─────────────────────────────────────────────────────────────
# v4-chat — ignore rules
# ─────────────────────────────────────────────────────────────

# macOS
.DS_Store

# Build outputs / generated artifacts
/build/
/dist/
*.o
*.class
__pycache__/
*.log

# Native loader + Java agent build outputs
/src/injector/loader_test
/src/injector/shatest
/src/injector/java_agent/agent.jar

# The packed bundle is generated by `make bundle`
/bundle.dat

# Payload binaries are never committed or published — the client is rebuilt
# from src/payload by CI (see .github/workflows/release.yml). These paths are
# only ever used by the local dev refresh tooling.
/payload.bin
/payload_jar/
/src/payload/target/

# Local dev tools (decompilers), never committed
/tools/*.jar

# Vendored deobfuscator build output
/zkm-flowdeobf/build/
/zkm-flowdeobf/.gradle/
